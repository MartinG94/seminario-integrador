# ==============================================================================
# .env.example — Plantilla de Variables de Entorno (SGD-AVEIT)
# ==============================================================================
# Copia este archivo como '.env' en la raíz y define los valores locales.
# NUNCA agregues contraseñas reales ni subas el archivo '.env' a Git.
# ==============================================================================

# --- Base de Datos Relacional (MySQL 8.0) ---
MYSQL_DATABASE=aveit_tribunal_dev
MYSQL_USER=aveit_dev
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_HOST=db
MYSQL_PORT=3306
# Switch opcional para desarrollo desacoplado sin MySQL (por defecto False)
USE_SQLITE=False

# --- Backend Django 4.2+ LTS (Python 3.12) ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=core.settings
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- Autenticación SimpleJWT (Claims & Duración) ---
JWT_SIGNING_KEY=
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Frontend Angular 14 SPA ---
API_URL=http://localhost:8000/api/v1

# --- Servicio de Correo / Notificaciones (SMTP & Gmail) ---
INTERNAL_SERVICE_KEY=aveit-internal-service-secret-2026
DEFAULT_FROM_EMAIL=notificaciones@aveit.utn.edu.ar
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=5
# Para autenticación SMTP tradicional con App Password (Contraseña de aplicación de 16 caracteres):
EMAIL_HOST_USER=tu_cuenta@gmail.com
EMAIL_HOST_PASSWORD=

# --- Google Cloud Console / Gmail OAuth 2.0 (Opcional para APIs OAuth2) ---
# Consultar instructivo en docs/configuracion/GUIA_CONFIGURACION_GMAIL.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

